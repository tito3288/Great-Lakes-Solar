---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import Process from "../../components/Process.astro";
import CtaBand from "../../components/CtaBand.astro";

const features = [
  {
    title: "Level 2 home charging",
    body: "240V chargers that fill a typical EV overnight. We size the circuit, run the wire, and mount the unit where it actually works for your garage or driveway.",
  },
  {
    title: "Paired with solar",
    body: "Charge from your own panels during the day, store the rest in your battery, and skip the utility’s peak rates. We design the system so it all works together.",
  },
  {
    title: "Clean installation",
    body: "Conduit runs hidden where possible, panels labeled, breakers properly sized. Inspection-ready every time.",
  },
  {
    title: "Brand-agnostic",
    body: "Tesla Wall Connector, ChargePoint, Wallbox, Enphase IQ — we install the unit that matches your EV and your budget.",
  },
];

const evFaqs = [
  {
    q: "Do I need to upgrade my electrical panel?",
    a: "Sometimes. Older panels may not have the capacity for a Level 2 charger. We check during the consultation and quote the upgrade separately if needed — no surprises.",
  },
  {
    q: "Can I add a charger without solar?",
    a: "Yes. Many of our charger installs are stand-alone. If you add solar later, the system can be wired to coordinate.",
  },
  {
    q: "Are there tax credits or rebates?",
    a: "Often, depending on your utility and federal program availability. We share what we know but recommend confirming with your tax advisor — programs change.",
  },
];
---

<BaseLayout
  title="EV Chargers | Great Lakes Solar"
  description="Level 2 home EV charger installation, brand-agnostic. Pair with solar and battery for the cleanest, cheapest charging."
>
  <Header />
  <main>
    <ServiceHero
      eyebrow="EV Chargers"
      heading="Charge at home. Charge from the sun."
      subhead="Level 2 home chargers installed clean — paired with your solar and battery system for the cheapest miles you’ll ever drive."
      ctaLabel="Get an EV Charger Quote"
    />

    <section class="py-16 sm:py-20" aria-labelledby="ev-features-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="max-w-3xl" data-reveal="fade-up">
          <p class="text-xs uppercase tracking-[.25em] text-teal font-bold">
            What we offer
          </p>
          <h2
            id="ev-features-heading"
            class="text-4xl sm:text-5xl font-semibold mt-4 leading-tight"
          >
            Real Level 2 charging. Properly installed.
          </h2>
          <p class="mt-5 text-lg text-slate-600">
            Plug-in trickle charging on a standard outlet isn’t enough for most
            EVs. We install Level 2 units that actually keep up with your
            driving.
          </p>
        </div>

        <ul
          class="mt-10 sm:mt-12 grid gap-5 md:grid-cols-2 list-none p-0"
          data-reveal-stagger="120"
        >
          {
            features.map((f) => (
              <li
                class="bg-white rounded-[2rem] p-7 sm:p-8 border border-black/5 shadow-sm"
                data-reveal="fade-up"
              >
                <h3 class="text-2xl font-semibold leading-tight">{f.title}</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">{f.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Process />

    <section class="py-16 sm:py-20 bg-cream" aria-labelledby="ev-faq-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div data-reveal="fade-up">
          <p class="text-xs uppercase tracking-[.25em] text-teal font-bold">
            EV Charger FAQs
          </p>
          <h2
            id="ev-faq-heading"
            class="text-4xl sm:text-5xl font-semibold mt-4 mb-8 leading-tight"
          >
            Questions worth asking.
          </h2>
        </div>
        <div class="space-y-4" data-reveal-stagger="100">
          {
            evFaqs.map((item, i) => {
              const id = `ev-faq-${i}`;
              return (
                <details
                  class="faq bg-white rounded-2xl p-6 group"
                  data-reveal="fade-up"
                >
                  <summary
                    class="list-none flex justify-between items-start gap-4 text-xl font-semibold cursor-pointer"
                    aria-controls={id}
                  >
                    <span>{item.q}</span>
                    <span
                      class="faq-toggle text-2xl leading-none select-none text-teal"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <p id={id} class="mt-4 text-slate-600 leading-relaxed">
                    {item.a}
                  </p>
                </details>
              );
            })
          }
        </div>
      </div>
    </section>

    <CtaBand
      eyebrow="Free site assessment"
      heading="Get a real install quote. Not a guess."
      body="We check your panel, walk the install path, and quote the wire and labor honestly. If a panel upgrade is needed, you’ll know up front."
      ctaLabel="Schedule an EV Charger Consultation"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq[open] .faq-toggle::before {
    content: "–";
  }
  .faq[open] .faq-toggle {
    font-size: 0;
  }
  .faq[open] .faq-toggle::before {
    font-size: 1.5rem;
  }
</style>
