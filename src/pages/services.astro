---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Certifications from "../components/Certifications.astro";
import CtaBand from "../components/CtaBand.astro";

const services = [
  {
    number: "01",
    title: "Solar",
    body: "Roof-mount, ground-mount, off-grid, and whole-home battery backup — backed by a 95% production guarantee, 25-year warranties, and certifications from Tesla, SolarEdge, Enphase, Franklin, and GM Energy.",
    href: "/services/solar",
    featured: true,
    image: "/IMG_1469.jpeg",
    imageAlt: "Residential home with rooftop solar installation",
  },
  {
    number: "02",
    title: "Roofing",
    body: "A solid roof is the foundation of a solid solar install. Full replacements, repairs, and pre-solar inspections.",
    href: "/services/roofing",
  },
  {
    number: "03",
    title: "Windows",
    body: "Energy-efficient windows from Alside Mezzo and other trusted brands, professionally installed.",
    href: "/services/windows",
  },
  {
    number: "04",
    title: "Doors",
    body: "Entry, patio, and storm doors that match the look and tightness your home deserves.",
    href: "/services/doors",
  },
  {
    number: "05",
    title: "EV Chargers",
    body: "Level 2 home charging installed clean — paired with solar or stand-alone.",
    href: "/services/ev-chargers",
  },
  {
    number: "06",
    title: "Tree Services",
    body: "Trimming and removal so panels see the sun and your roof stays protected year-round.",
    href: "/services/tree-services",
  },
];

const additionalProjects = [
  "Gutters & downspouts",
  "HVAC",
  "Generators",
  "Foam insulation",
  "Siding",
  "Interior & exterior painting",
  "Air purification",
  "Landscaping",
  "Concrete",
  "Drywall",
  "Smart thermostats",
  "Carports & custom construction",
];
---

<BaseLayout
  title="Services | Great Lakes Solar"
  description="Solar, roofing, windows, doors, EV chargers, and tree services. One licensed contractor for the upgrades around your roof."
>
  <Header />
  <main>
    <ServiceHero
      eyebrow="Services"
      heading="Solar + home upgrades."
      subhead="Great Lakes Solar is your single licensed contractor for the work that surrounds a solar install. Fewer crews to manage, fewer surprises, one team accountable."
      image="/IMG_0836.JPG"
      imageAlt="Residential home with rooftop solar installation and service van"
      ctaLabel="Start a Consultation"
    />

    <section id="home-improvement" class="py-16 sm:py-20" aria-labelledby="home-improvement-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="max-w-3xl" data-reveal="fade-up">
          <p class="text-xs uppercase tracking-[.25em] text-teal font-bold">
            Home improvement
          </p>
          <h2
            id="home-improvement-heading"
            class="text-4xl sm:text-5xl lg:text-6xl font-semibold mt-4 leading-tight"
          >
            Solar, roofing, windows, doors, and the work around them.
          </h2>
          <p class="mt-5 text-lg text-slate-600">
            Solar is our specialty. Home improvement is the full picture. Great
            Lakes Solar helps homeowners improve the whole property, from the
            system on the roof to the roof itself, windows, doors, EV charging,
            tree work, and other upgrades that protect your investment.
          </p>
        </div>

        <div
          class="mt-10 sm:mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
          data-reveal-stagger="100"
        >
          {services.map((s) => <ServiceCard {...s} />)}
        </div>

        <div
          class="mt-8 sm:mt-10 bg-white rounded-[2rem] p-6 sm:p-8 border border-black/5 shadow-sm flex flex-col lg:flex-row gap-5 lg:gap-8 lg:items-center lg:justify-between"
          data-reveal="fade-up"
        >
          <div class="max-w-3xl">
            <h3 class="text-2xl sm:text-3xl font-semibold leading-tight">
              Don’t see your project listed?
            </h3>
            <p class="mt-3 text-lg leading-relaxed text-slate-600">
              Tell us what you want to improve. We handle a wide range of home
              improvement work, and if your project needs a specialized path,
              we’ll help you figure out the right next step.
            </p>
            <ul class="mt-5 flex flex-wrap gap-2.5 list-none p-0">
              {
                additionalProjects.map((project) => (
                  <li class="rounded-full bg-cream px-3.5 py-2 text-sm font-semibold text-slate-700 border border-black/5">
                    {project}
                  </li>
                ))
              }
            </ul>
          </div>
          <a
            href="/contact"
            class="inline-flex justify-center items-center bg-amber text-ink rounded-full px-7 py-3.5 font-bold hover:bg-amber/90 transition-colors shrink-0"
          >
            Get a Home Improvement Quote
          </a>
        </div>
      </div>
    </section>

    <Certifications />

    <CtaBand
      eyebrow="Not sure where to start?"
      heading="Start with a single conversation."
      body="Tell us what you’re trying to solve — solar, a leaky roof, drafty windows, a charger you’ve been putting off. We’ll walk you through what makes sense and what doesn’t."
      ctaLabel="Schedule a Consultation"
      ctaHref="/contact"
    />
  </main>
  <Footer />
</BaseLayout>
