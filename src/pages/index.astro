  description="Great Lakes Solar helps homeowners understand roof fit, energy goals, system design, and installation next steps without jargon or pressure."
>
  <Header />
  <main>
    <Hero />
    <Benefits />
    <HomeownerStory />
    <Process />
    <DarkBand />
    <Faq />
