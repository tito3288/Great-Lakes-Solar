---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Certifications from "../components/Certifications.astro";
import Benefits from "../components/Benefits.astro";
import HomeownerStory from "../components/HomeownerStory.astro";
import Process from "../components/Process.astro";
import ServicesTeaser from "../components/ServicesTeaser.astro";
import DarkBand from "../components/DarkBand.astro";
import Reviews from "../components/Reviews.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Great Lakes Solar | Solar, Roofing, Windows & Home Upgrades"
  description="Top 20 US solar company. 25-year warranties, 95% production guarantee, whole-home battery backup. Plus roofing, windows, doors, EV chargers, and tree services across the Great Lakes region."
>
  <Header />
  <main>
    <Hero />
    <Certifications />
    <Benefits />
    <HomeownerStory />
    <Process />
    <ServicesTeaser />
    <DarkBand />
    <Reviews />
    <Faq />
  </main>
  <Footer />
</BaseLayout>
