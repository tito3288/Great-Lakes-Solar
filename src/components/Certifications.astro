---
interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;

const partners = [
  {
    name: "Tesla",
    logo: "/partner-logos/tesla-logo-trimmed.webp",
    logoWidth: "4.25rem",
    mobileLogoWidth: "3.75rem",
  },
  {
    name: "SolarEdge",
    logo: "/partner-logos/SolarEdge_logo_header_new_0.png",
    logoWidth: "10.25rem",
    mobileLogoWidth: "8.75rem",
  },
  {
    name: "Enphase",
    logo: "/partner-logos/Enphase-Logo.png",
    logoWidth: "5rem",
    mobileLogoWidth: "4.5rem",
  },
  {
    name: "Aurora",
    logo: "/partner-logos/aurora-logo-trimmed.webp",
    logoWidth: "8rem",
    mobileLogoWidth: "7rem",
  },
  {
    name: "Qcells",
    logo: "/partner-logos/post-featured_cropped.webp",
    logoWidth: "7.25rem",
    mobileLogoWidth: "6.5rem",
  },
  {
    name: "Jinko Solar",
    logo: "/partner-logos/logony.png",
    logoWidth: "8.25rem",
    mobileLogoWidth: "7.5rem",
  },
];

const badges = [
  "Top 20 US Solar Company",
  "15 Years In Business",
  "Licensed, Bonded, Insured",
];

const sectionClass =
  variant === "dark"
    ? "py-12 sm:py-16 bg-ink text-white"
    : "py-12 sm:py-16 bg-cream";

const labelClass = variant === "dark" ? "text-amber" : "text-teal";
const dividerClass =
  variant === "dark" ? "border-white/10" : "border-black/10";
const badgeTextClass =
  variant === "dark" ? "text-white/80" : "text-slate-600";
const stripClass =
  variant === "dark" ? "bg-white/5" : "bg-white/70";
const logoTileClass =
  variant === "dark"
    ? "bg-white text-ink border-white/10"
    : "bg-white text-ink border-black/5";
---

<section class={sectionClass} aria-labelledby="certifications-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center" data-reveal="fade-up">
      <p class={`text-xs uppercase tracking-[.25em] font-bold ${labelClass}`}>
        Certified & credentialed
      </p>
      <h2
        id="certifications-heading"
        class="text-2xl sm:text-3xl font-semibold mt-3"
      >
        Certified partners. Best in the game.
      </h2>
    </div>
  </div>

  <div
    class={`mt-8 sm:mt-10 ${stripClass} py-5 sm:py-7`}
    data-reveal="fade-up"
  >
    <ul class="max-w-4xl mx-auto px-4 sm:px-6 grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 list-none m-0">
      {
        partners.map((p) => (
          <li
            class={`min-h-28 sm:min-h-36 rounded-2xl border shadow-sm flex items-center justify-center p-5 sm:p-7 ${logoTileClass}`}
          >
            <img
              src={p.logo}
              alt={p.name}
              class="partner-logo object-contain"
              style={`--logo-width: ${p.logoWidth}; --mobile-logo-width: ${p.mobileLogoWidth};`}
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div
      class={`mt-8 sm:mt-10 pt-6 sm:pt-8 border-t ${dividerClass} flex flex-wrap items-center justify-center gap-x-6 sm:gap-x-10 gap-y-3 text-sm sm:text-base ${badgeTextClass}`}
      data-reveal="fade-up"
    >
      {
        badges.map((b, i) => (
          <span class="inline-flex items-center gap-3">
            {i > 0 && (
              <span class="hidden sm:inline text-current opacity-30" aria-hidden="true">
                •
              </span>
            )}
            <span class="font-medium">{b}</span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .partner-logo {
    display: block;
    width: var(--mobile-logo-width);
    max-width: 100%;
    max-height: 4.5rem;
  }

  @media (min-width: 640px) {
    .partner-logo {
      width: var(--logo-width);
      max-height: 5rem;
    }
  }
</style>
