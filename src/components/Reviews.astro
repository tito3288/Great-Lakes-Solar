---
const reviews = [
  {
    quote:
      "The team explained everything in plain language and stuck to what they said the system would do. No surprises, no pressure — just a clean install that works.",
    name: "M. Anderson",
    location: "Grand Rapids, MI",
  },
  {
    quote:
      "We added a whole-home battery alongside the panels. When the grid went down last winter, we never noticed. Worth every penny.",
    name: "J. & L. Carter",
    location: "Holland, MI",
  },
  {
    quote:
      "I priced solar with three companies. Great Lakes was the only one that put the production guarantee and 25-year coverage in writing without me asking.",
    name: "R. Patel",
    location: "Ann Arbor, MI",
  },
];
---

<section class="py-16 sm:py-20 bg-cream" aria-labelledby="reviews-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl" data-reveal="fade-up">
      <p class="text-xs uppercase tracking-[.25em] text-teal font-bold">
        Homeowner reviews
      </p>
      <h2
        id="reviews-heading"
        class="text-4xl sm:text-5xl font-semibold mt-4 leading-tight"
      >
        Real homes. Real results. Real receipts.
      </h2>
    </div>

    <ul
      class="mt-10 sm:mt-12 grid gap-5 md:grid-cols-3 list-none p-0"
      data-reveal-stagger="120"
    >
      {
        reviews.map((r) => (
          <li
            class="bg-white rounded-[2rem] p-6 sm:p-8 border border-black/5 shadow-sm flex flex-col"
            data-reveal="fade-up"
          >
            <div
              class="flex items-center gap-1 text-amber"
              aria-label="5 out of 5 stars"
            >
              {[0, 1, 2, 3, 4].map(() => (
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L10 14.77 4.8 17.5l.99-5.78-4.21-4.1 5.82-.85L10 1.5z" />
                </svg>
              ))}
            </div>
            <blockquote class="mt-5 text-lg leading-relaxed text-ink flex-1">
              <p>“{r.quote}”</p>
            </blockquote>
            <figcaption class="mt-6 pt-5 border-t border-black/5">
              <p class="font-semibold text-ink">{r.name}</p>
              <p class="text-sm text-slate-500 mt-1">{r.location}</p>
            </figcaption>
          </li>
        ))
      }
    </ul>
  </div>
</section>
