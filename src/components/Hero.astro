---
---

<section class="relative" aria-labelledby="hero-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 sm:py-8 lg:py-16">
    <div
      class="relative rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden min-h-[560px] sm:min-h-[650px] flex items-end"
    >
      <img
        src="/hero.JPG"
        alt="Cinematic aerial photo of solar panels on a residential roof"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/10"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative p-5 sm:p-10 lg:p-14 grid lg:grid-cols-5 gap-5 sm:gap-8 w-full items-start"
      >
        <div class="lg:col-span-3 text-white" data-reveal="fade-up">
          <p
            class="text-[11px] sm:text-xs uppercase tracking-[.25em] mb-3 sm:mb-4 text-white/75"
          >
            Solar + home upgrades, done right
          </p>
          <h1
            id="hero-heading"
            class="text-[2.45rem] sm:text-6xl lg:text-7xl leading-[.94] sm:leading-[.9] tracking-tight font-semibold text-balance"
          >
            Solar guaranteed to work.
          </h1>
          <p class="mt-4 sm:mt-6 max-w-2xl text-base sm:text-xl text-white/80">
            Top 20 US solar company. 25-year warranties. Whole-home battery
            backup. Built and installed by a partner with 15 years in the field.
          </p>
        </div>

        <div
          class="lg:col-span-2 bg-white rounded-[1.5rem] sm:rounded-[1.75rem] p-5 sm:p-8 shadow-2xl text-ink"
          data-reveal="fade-up"
          style="--reveal-delay: 180ms;"
        >
          <p class="text-[11px] sm:text-xs uppercase tracking-[.2em] text-teal font-bold">
            Private consultation
          </p>
          <h2 class="text-2xl sm:text-3xl leading-tight font-semibold mt-2 sm:mt-3">
            Tell us what you want to upgrade.
          </h2>
          <p class="mt-3 sm:mt-4 text-slate-600 leading-relaxed">
            Free consultation. Real production projections. No pressure to sign on the spot.
          </p>
          <ul class="mt-4 sm:mt-5 space-y-2.5 text-sm sm:text-base text-slate-700">
            <li class="flex items-start gap-3">
              <span class="text-amber font-bold shrink-0" aria-hidden="true">→</span>
              In-home walkthrough on your schedule
            </li>
            <li class="flex items-start gap-3">
              <span class="text-amber font-bold shrink-0" aria-hidden="true">→</span>
              Written quote with the guarantees included
            </li>
            <li class="flex items-start gap-3">
              <span class="text-amber font-bold shrink-0" aria-hidden="true">→</span>
              Response within one business day
            </li>
          </ul>
          <a
            href="/contact"
            class="mt-5 sm:mt-6 block w-full text-center bg-amber rounded-xl py-3 font-bold hover:bg-amber/90 transition-colors"
          >
            Schedule a Consultation
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
