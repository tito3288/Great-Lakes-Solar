---
const faqs = [
  {
    q: "What does the 95% Power Production Guarantee actually mean?",
    a: "If your system produces less than 95% of what we projected for the year, we make it right — service, equipment, or compensation. The number is in your contract, not buried in fine print.",
  },
  {
    q: "What’s covered under the 25-year warranty?",
    a: "Equipment and workmanship for 25 years, with panels guaranteed at 84.7% efficiency or better after 30. That covers the panels themselves, the inverters, and the labor we put on your roof.",
  },
  {
    q: "Do you handle whole-home backup and off-grid setups?",
    a: "Yes. We design battery backup systems that keep the whole house powered during outages, and full off-grid systems for homeowners ready to leave the utility behind entirely.",
  },
  {
    q: "What other home services do you offer?",
    a: "Roofing, windows, doors, EV charger installation, and tree trimming and removal. One licensed contractor for the upgrades that surround a solar install — <a href='/services' class='text-teal underline hover:text-teal/80'>see all services</a>.",
    html: true,
  },
];
---

<section id="faq" class="py-16 sm:py-20" aria-labelledby="faq-heading">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div data-reveal="fade-up">
      <p class="text-xs uppercase tracking-[.25em] text-teal font-bold">FAQs</p>
      <h2 id="faq-heading" class="text-4xl sm:text-6xl font-semibold mt-4 mb-8">
        Questions worth asking.
      </h2>
    </div>
    <div class="space-y-4" data-reveal-stagger="100">
      {
        faqs.map((item, i) => {
          const id = `faq-${i}`;
          return (
            <details class="faq bg-white rounded-2xl p-6 group" data-reveal="fade-up">
              <summary
                class="list-none flex justify-between items-start gap-4 text-xl font-semibold cursor-pointer"
                aria-controls={id}
              >
                <span>{item.q}</span>
                <span
                  class="faq-toggle text-2xl leading-none select-none text-teal"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              {item.html ? (
                <p
                  id={id}
                  class="mt-4 text-slate-600 leading-relaxed"
                  set:html={item.a}
                />
              ) : (
                <p id={id} class="mt-4 text-slate-600 leading-relaxed">
                  {item.a}
                </p>
              )}
            </details>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq[open] .faq-toggle::before {
    content: "–";
  }
  .faq[open] .faq-toggle {
    font-size: 0;
  }
  .faq[open] .faq-toggle::before {
    font-size: 1.5rem;
  }
</style>
