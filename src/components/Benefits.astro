---
const benefits = [
  {
    number: "01",
    title: "95% Power Production Guarantee",
    body: "Your system actually produces what we project — or we make it right. The production guarantee is in writing, every time.",
    cardClass: "bg-white",
    badgeClass: "bg-amber/20 text-amber",
    bodyClass: "text-slate-600",
  },
  {
    number: "02",
    title: "25-Year Warranties",
    body: "Equipment and workmanship covered for a quarter-century. Panels guaranteed at 84.7% efficiency or better after 30 years.",
    cardClass: "bg-sand",
    badgeClass: "bg-white/70 text-teal",
    bodyClass: "text-slate-700",
  },
  {
    number: "03",
    title: "Whole-Home Battery Backup",
    body: "Power outages, no more. Pair your panels with storage and keep the lights on when the grid doesn’t.",
    cardClass: "bg-white",
    badgeClass: "bg-teal/10 text-teal",
    bodyClass: "text-slate-600",
  },
];
---

<section id="benefits" class="py-16 sm:py-20 lg:py-24" aria-labelledby="benefits-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-5xl mx-auto">
      <div data-reveal="fade-up">
        <p class="text-xs uppercase tracking-[.25em] text-teal font-bold">
          Guarantees, not maybes
        </p>
        <h2
          id="benefits-heading"
          class="text-4xl sm:text-6xl lg:text-7xl leading-[1.02] tracking-tight font-semibold mt-4 max-w-4xl"
        >
          Solar that has to perform. Proof in writing.
        </h2>
        <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-2xl">
          The industry runs on estimates and disclaimers. We work the other way:
          concrete numbers, long warranties, and a system designed to keep
          producing decades after install day.
        </p>
        <div class="mt-8 flex items-center gap-3 text-sm font-semibold text-teal">
          <span
            class="h-10 w-10 rounded-full bg-teal/10 flex items-center justify-center shrink-0"
            aria-hidden="true"
          >
            ✓
          </span>
          Stop renting your power forever. Own your power for 70–85% less.
        </div>
      </div>

      <ul
        class="mt-12 sm:mt-16 grid gap-5 lg:gap-6 list-none p-0"
        data-reveal-stagger="140"
      >
        {
          benefits.map((b) => (
            <li
              class={`group ${b.cardClass} rounded-[2rem] p-6 sm:p-8 lg:p-9 border border-black/5 shadow-sm hover:shadow-md transition sm:min-h-[220px] flex items-center`}
              data-reveal="fade-up"
            >
              <div class="grid md:grid-cols-[auto_1fr] gap-5 lg:gap-7 items-start w-full">
                <div
                  class={`h-12 w-12 rounded-2xl ${b.badgeClass} flex items-center justify-center text-lg font-bold`}
                  aria-hidden="true"
                >
                  {b.number}
                </div>
                <div>
                  <h3 class="text-2xl sm:text-3xl font-semibold leading-tight">
                    {b.title}
                  </h3>
                  <p class={`mt-3 ${b.bodyClass} text-lg leading-relaxed`}>{b.body}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
