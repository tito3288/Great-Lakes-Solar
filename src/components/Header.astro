---
import { site } from "../lib/site";
---

<header class="sticky top-0 z-50 bg-cream/90 backdrop-blur border-b border-black/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
    <a href="/" class="inline-flex items-center" aria-label="Great Lakes Solar — home">
      <img
        src="/Great%20Solar.png"
        alt="Great Lakes Solar logo"
        class="h-16 sm:h-20 w-auto max-w-[260px] object-contain"
        loading="eager"
      />
    </a>

    <nav
      class="hidden md:flex items-center gap-8 text-sm uppercase tracking-wider"
      aria-label="Primary"
    >
      <a href="/" class="hover:text-teal transition-colors">Home</a>
      <a href="/services" class="hover:text-teal transition-colors">Services</a>
      <a href="/gallery" class="hover:text-teal transition-colors">Gallery</a>
      <a href="/about" class="hover:text-teal transition-colors">About</a>
      <a href="/contact" class="hover:text-teal transition-colors">Contact</a>
      <a
        href={site.phoneHref}
        class="hidden lg:inline-flex items-center gap-2 normal-case tracking-normal font-semibold hover:text-teal transition-colors"
        aria-label={`Call Great Lakes Solar at ${site.phoneDisplay}`}
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.84 2.852a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
          ></path>
        </svg>
        {site.phoneDisplay}
      </a>
      <a
        href="/contact"
        class="bg-ink text-white px-5 py-3 rounded-full normal-case tracking-normal font-semibold hover:bg-ink/90 transition-colors"
      >
        Get a Quote
      </a>
    </nav>

    <button
      id="menuBtn"
      class="md:hidden border border-black/10 rounded-lg p-2"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobileMenu" class="hidden md:hidden px-4 pb-4 bg-cream">
    <a class="block py-3 border-b border-black/10" href="/">Home</a>
    <a class="block py-3 border-b border-black/10" href="/services">Services</a>
    <a class="block py-3 border-b border-black/10" href="/gallery">Gallery</a>
    <a class="block py-3 border-b border-black/10" href="/about">About</a>
    <a class="block py-3 border-b border-black/10" href="/contact">Contact</a>
    <a
      class="flex items-center gap-2 py-3 border-b border-black/10 font-semibold"
      href={site.phoneHref}
    >
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.84 2.852a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
        ></path>
      </svg>
      {site.phoneDisplay}
    </a>
    <a
      class="block mt-3 text-center bg-ink text-white rounded-full py-3 font-semibold"
      href="/contact"
    >
      Get a Quote
    </a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => {
      const isHidden = mobileMenu.classList.toggle("hidden");
      menuBtn.setAttribute("aria-expanded", String(!isHidden));
      menuBtn.setAttribute("aria-label", isHidden ? "Open menu" : "Close menu");
    });

    mobileMenu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        menuBtn.setAttribute("aria-expanded", "false");
        menuBtn.setAttribute("aria-label", "Open menu");
      });
    });
  }
</script>
