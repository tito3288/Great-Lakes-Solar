---
import { site } from "../lib/site";

const year = new Date().getFullYear();

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "All Services", href: "/services" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const services = [
  { label: "Solar", href: "/services/solar" },
  { label: "Roofing", href: "/services/roofing" },
  { label: "Windows", href: "/services/windows" },
  { label: "Doors", href: "/services/doors" },
  { label: "EV Chargers", href: "/services/ev-chargers" },
  { label: "Tree Services", href: "/services/tree-services" },
];
---

<footer class="bg-white border-t border-black/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 sm:py-16">
    <div class="grid gap-10 sm:gap-12 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal="fade-up">
        <img
          src="/Great%20Solar.png"
          alt="Great Lakes Solar logo"
          class="h-12 sm:h-14 w-auto max-w-[210px] object-contain"
          loading="lazy"
        />
        <p class="mt-5 text-slate-600 max-w-md leading-relaxed">
          Solar, roofing, windows, doors, EV chargers, and tree services for
          homeowners across the Great Lakes region. One licensed contractor for
          the upgrades around your roof.
        </p>
        <a
          href="/services/solar"
          class="mt-5 inline-flex items-center gap-3 group"
        >
          <img
            src="/IMG_8176.PNG"
            alt="Universal Solar Direct logo"
            class="h-14 sm:h-16 w-auto object-contain"
            loading="lazy"
          />
          <span class="text-xs uppercase tracking-[.2em] text-slate-500 group-hover:text-teal transition-colors">
            Powered by Universal Solar Direct
          </span>
        </a>
      </div>

      <nav
        class="lg:col-span-2"
        aria-labelledby="footer-quick-links"
        data-reveal="fade-up"
      >
        <h2
          id="footer-quick-links"
          class="text-xs uppercase tracking-[.25em] font-bold text-ink"
        >
          Site
        </h2>
        <ul class="mt-5 space-y-3 text-slate-600">
          {
            quickLinks.map((l) => (
              <li>
                <a href={l.href} class="hover:text-teal transition-colors">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        class="lg:col-span-2"
        aria-labelledby="footer-services"
        data-reveal="fade-up"
      >
        <h2
          id="footer-services"
          class="text-xs uppercase tracking-[.25em] font-bold text-ink"
        >
          Services
        </h2>
        <ul class="mt-5 space-y-3 text-slate-600">
          {
            services.map((l) => (
              <li>
                <a href={l.href} class="hover:text-teal transition-colors">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-3" data-reveal="fade-up">
        <h2 class="text-xs uppercase tracking-[.25em] font-bold text-ink">
          Get Started
        </h2>
        <p class="mt-5 text-slate-600 leading-relaxed">
          Ready to talk through your roof, your goals, and your options?
        </p>
        <a
          href="/contact"
          class="mt-5 inline-flex bg-ink text-white rounded-full px-6 py-3 font-semibold hover:bg-ink/90 transition-colors"
        >
          Schedule a Consultation
        </a>
        <dl class="mt-6 space-y-1.5 text-sm text-slate-600">
          <div class="flex gap-2">
            <dt class="font-semibold text-ink">Call</dt>
            <dd>
              <a
                href={site.phoneHref}
                class="hover:text-teal transition-colors"
              >
                {site.phoneDisplay}
              </a>
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-semibold text-ink">Hours</dt>
            <dd>{site.hours}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div
      class="mt-12 sm:mt-14 pt-6 border-t border-black/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-slate-500"
    >
      <p>&copy; {year} Great Lakes Solar. All rights reserved.</p>
      <p>Licensed, bonded, and insured. Serving {site.serviceArea}.</p>
    </div>
  </div>
</footer>
